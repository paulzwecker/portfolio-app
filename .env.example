# Copy to .env at repository root. Never commit credentials.
# Run infra/create-local-db.sql with psql first; replace change-me below.
# Percent-encode special characters in URL passwords (e.g. @ becomes %40).
DATABASE_URL=postgresql+psycopg://portfolio_app:change-me@127.0.0.1:5432/portfolio_app
# Guarded test writes require an explicit disposable local target (no Neon credentials):
# DATABASE_TARGET_ENVIRONMENT=development
# DATABASE_TARGET_DATABASE=portfolio_app_test
# DATABASE_LOCAL_TEST_WRITES_AUTHORIZED=true
# Other local writes need explicit target name and authorization:
# DATABASE_TARGET_ENVIRONMENT=development
# DATABASE_TARGET_DATABASE=portfolio_app
# DATABASE_LOCAL_WRITES_AUTHORIZED=true
# Neon writes require explicit project/branch/endpoint IDs and API authorization.
# DATABASE_TARGET_ENVIRONMENT=rehearsal
# DATABASE_TARGET_DATABASE=<database-name>
# NEON_API_KEY=<operator-secret>
# NEON_PROJECT_ID=<project-id>
# NEON_BRANCH_ID=<isolated-branch-id>
# NEON_ENDPOINT_ID=<direct-endpoint-id>
# DATABASE_REHEARSAL_WRITES_AUTHORIZED=true
# Production writes additionally require DATABASE_TARGET_ENVIRONMENT=production,
# DATABASE_PRODUCTION_WRITES_AUTHORIZED=true, a verified primary branch and (for
# bootstrap) an interactive exact-target confirmation. Never enable this casually.
# Required only for SEC reported-fundamentals imports; identify this app and provide a contact.
# SEC_USER_AGENT=Portfolio Research App analyst@example.com
# Optional: FMP analyst-estimates snapshots. Requires reviewed mappings and a plan/agreement
# permitting raw-data storage and app display; a free personal key alone is not sufficient.
# FMP_API_KEY=your-provider-api-key
# Optional read-only Sheets model-contract sync. Share the workbook with this account as Viewer.
# Keep the service-account JSON key outside the repository.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEETS_SYNC_TAB=Application Model Sync Inbox
# Optional exact portfolio workbook Drive ID. If empty, the configured spreadsheet ID is used.
GOOGLE_DRIVE_PORTFOLIO_WORKBOOK_FILE_ID=
# Separate source-acquisition identity for the market-data workbook; not used by portfolio sync.
GOOGLE_DRIVE_MARKET_DATA_WORKBOOK_FILE_ID=
# Fail closed by default. Enable only after operational approval; never use polling to apply
# portfolio workbook changes. Model/research inbox polling is separate from portfolio sync.
GOOGLE_SHEETS_POLL_SECONDS=0
RECURRING_OPERATIONS_ENABLED=false
MANUAL_OPERATIONS_ENABLED=false
WORKBOOK_SYNC_ENABLED=false
# Provider ingestion remains a separate, opt-in operation.
CLOUD_INGESTION_ENABLED=false
# Leave disabled unless FMP terms explicitly permit canonical ingestion and display.
FMP_CONSENSUS_INGESTION_ENABLED=false
# Optional dedicated database for migration/integration tests. Never use your app DB.
# TEST_DATABASE_URL=postgresql+psycopg://portfolio_app:change-me@127.0.0.1:5432/portfolio_app_test

# Server-only: the browser calls Next.js /api/health, which calls this API origin.
API_BASE_URL=http://127.0.0.1:8000

# Optional, separate credentials for agent-authored model revision proposals.
# Configure distinct random tokens (32+ characters) and distinct identities.
# Agent tokens can submit proposals and inspect only their own status; reviewer tokens
# can preview, accept or reject. They grant no access to other API routes.
MODEL_PROPOSAL_AGENT_TOKEN=
MODEL_PROPOSAL_AGENT_ID=
MODEL_PROPOSAL_REVIEWER_TOKEN=
MODEL_PROPOSAL_REVIEWER_ID=

# Remote deployment only. Keep secrets in Render/Vercel environment settings.
# APP_ENV=production
# API_ACCESS_TOKEN=generate-a-random-value-of-at-least-32-characters
# CLOUD_INGESTION_ENABLED=false
# Vercel server-only access gate. Do not prefix these names with NEXT_PUBLIC_.
# WEB_ACCESS_USERNAME=researcher
# WEB_ACCESS_PASSWORD=use-a-long-random-password

